# ❄️ FREEZER MD - example configuration
# Copy this file to `.env` (local) or set the same keys as environment variables
# on Heroku / Render / Railway. NEVER commit your real .env file.

# --- Identity -------------------------------------------------------------
BOT_NAME=FREEZER MD
OWNER_NAME=Your Name
# Owner number(s), digits only with country code, comma separated. Example: 254712345678
OWNER_NUMBER=
# One or more command prefixes, comma separated. Example: .,!
PREFIX=.
# public = everyone can use the bot, private = owner only
MODE=public
TZ=Africa/Nairobi

# --- Connection -----------------------------------------------------------
PORT=3000
# Access key for the web connect page (QR / pairing code). Leave empty to get a
# random key printed in the terminal on every start.
WEB_KEY=
# Optional: link with a pairing code automatically instead of a QR code.
# Digits only with country code, e.g. 254712345678
PAIRING_NUMBER=
# Optional: session string (FREEZER~...) for hosts with an ephemeral disk.
# Generate it locally with `npm run session`. Treat it like a password.
# Also accepted: POPKID~, F~, SILA-MD~, NEXUS___ prefixed strings (zip or gzip payload).
SESSION_ID=

# --- Look & feel ----------------------------------------------------------
# Optional menu image: https URL or a local path. assets/menu.jpg is auto-detected.
MENU_IMAGE=
STICKER_PACK=FREEZER MD
STICKER_AUTHOR=Made with ❄️

# --- Behaviour ------------------------------------------------------------
AUTO_READ=false
AUTO_TYPING=true
NOTIFY_OWNER=true
COOLDOWN_MS=1200
MAX_MEDIA_MB=60

# --- Optional API keys (everything has a free fallback where possible) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
# Google Custom Search (for the .google command; DuckDuckGo is used if empty)
GOOGLE_API_KEY=
GOOGLE_CX=
# Path to a cookies.txt for yt-dlp (helps with YouTube/Instagram rate limits)
YTDLP_COOKIES=
